<header class="header">
  <nav class="nav">
    <div class="nav-container">
      <!-- Logo (text-based serif like Falling Waters) -->
      <a href="{{ '/' | url }}" class="nav-logo">
        Dr. Noot
      </a>
      
      <!-- Mobile hamburger menu -->
      <button class="nav-toggle" aria-label="Toggle menu" aria-expanded="false">
        <span></span>
        <span></span>
        <span></span>
      </button>
      
      <!-- Navigation links -->
      <ul class="nav-links">
        {% for item in site.nav %}
        <li><a href="{{ item.url | url }}">{{ item.label }}</a></li>
        {% endfor %}
        
        <!-- Phone CTA -->
        <li><a href="tel:{{ site.phone }}" class="nav-phone">{{ site.phone }}</a></li>
        
        <!-- Primary CTA button (pill-shaped like Falling Waters) -->
        <li><a href="{{ site.cta.url | url }}" class="btn nav-cta">{{ site.cta.text }}</a></li>
      </ul>
    </div>
  </nav>
</header>

<!-- Mobile Menu Overlay -->
<div class="mobile-menu" id="mobileMenu">
  <a href="{{ '/' | url }}">Home</a>
  {% for item in site.nav %}
  <a href="{{ item.url | url }}">{{ item.label }}</a>
  {% endfor %}
  <a href="tel:{{ site.phone }}" class="nav-phone">{{ site.phone }}</a>
  <a href="{{ site.cta.url | url }}" class="btn btn-accent">{{ site.cta.text }}</a>
</div>